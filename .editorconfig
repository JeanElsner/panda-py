# Complements the pre-commit hooks for editors that do not run them.
# Authoritative formatting lives in pyproject.toml (black) and .clang-format.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.py]
indent_style = space
indent_size = 4
max_line_length = 88

[*.{c,cc,cpp,h,hpp}]
indent_style = space
indent_size = 2

[*.{yml,yaml,json,toml}]
indent_style = space
indent_size = 2

# Generated by bin/gen_stubs.sh, left as the generator writes them.
[src/panda_py/*.pyi]
trim_trailing_whitespace = false

# Applied verbatim, whitespace is significant.
[bin/patches/*.patch]
trim_trailing_whitespace = false
insert_final_newline = false
